{
  "name": "roblox-script-templates",
  "displayName": "Roblox Script Templates",
  "description": "Create Roblox scripts (module/server/client) from configurable templates.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "roblox-script-templates.newScript",
        "title": "New Roblox Script..."
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "roblox-script-templates.newScript",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Roblox Script Templates",
      "properties": {
        "roblox-script-templates.templates.server": {
          "type": "string",
          "order": 0,
          "editPresentation": "multilineText",
          "default": "--- | Services | ---\n\n--- | Modules | ---\n\n--- | Variables | ---\n\n--- | Functions | ---\n",
          "markdownDescription": "Template for new **Server Scripts** (`.server.luau`). `{name}` is replaced with the script name."
        },
        "roblox-script-templates.templates.client": {
          "type": "string",
          "order": 1,
          "editPresentation": "multilineText",
          "default": "--- | Services | ---\n\n--- | Modules | ---\n\n--- | Variables | ---\n\n--- | Functions | ---\n",
          "markdownDescription": "Template for new **Client Scripts** (`.client.luau`). `{name}` is replaced with the script name."
        },
        "roblox-script-templates.templates.module": {
          "type": "string",
          "order": 2,
          "editPresentation": "multilineText",
          "default": "--- | Services | ---\n\n--- | Modules | ---\n\n--- | Types | ---\n\nlocal {name} = {}\n\nreturn {name}",
          "markdownDescription": "Template for new **Module Scripts** (`.luau`). `{name}` is replaced with the script name, e.g. `local {name} = {}`."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}